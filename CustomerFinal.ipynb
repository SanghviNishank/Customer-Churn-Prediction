    "    prec = precision_score(y_test, y_pred_thresh)\n",
    "    f1 = f1_score(y_test, y_pred_thresh)\n",
    "    print(f\"{thresh:<10} {acc:<10.4f} {rec:<10.4f} {prec:<10.4f} {f1:<10.4f}\")"
   ]
  },
